{
  "name": "selora",
  "version": "0.6.0",
  "description": "Open-source CLI for the Selora API gateway",
  "type": "module",
  "bin": {
    "selora": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "selora",
    "cli",
    "api",
    "llm",
    "ai-gateway"
  ],
  "license": "MIT",
  "repository": "https://github.com/ToxicAngelX/selora-cli",
  "author": "Toxic <toxic@selora.lol>",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.7.0",
    "eslint": "^9.39.2",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "picocolors": "^1.1.1"
  }
}
